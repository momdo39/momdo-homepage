<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>デスクワーク特化型・骨格トータルリセットコース | 〇〇整体院</title>
    <style>
        /* ベーススタイル */
        :root {
            --primary-color: #005caf; /* マクダビッド風のメディカルブルー */
            --secondary-color: #f2f6f9; /* 明るいグレー */
            --accent-color: #e67e22; /* 行動を促すアクセントオレンジ */
            --text-color: #333333;
            --light-text: #666666;
        }

        body {
            font-family: "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
            line-height: 1.7;
            color: var(--text-color);
            margin: 0;
            padding: 0;
            background-color: #fff;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
            box-sizing: border-box;
        }

        h2 {
            font-size: 28px;
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 40px;
            position: relative;
            padding-bottom: 10px;
        }

        h2::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background-color: var(--primary-color);
        }

        /* ボタン（CTA） */
        .btn-cta {
            display: block;
            width: 100%;
            max-width: 500px;
            margin: 30px auto;
            background-color: var(--accent-color);
            color: #fff;
            text-align: center;
            padding: 20px 10px;
            font-size: 20px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(230, 126, 34, 0.4);
            transition: all 0.3s ease;
        }

        .btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(230, 126, 34, 0.6);
        }

        /* 1. ファーストビュー */
        .hero {
            background: linear-gradient(135deg, #eef5fc 0%, #ffffff 100%);
            padding: 60px 0;
            text-align: center;
        }

        .hero h1 {
            font-size: 32px;
            color: var(--text-color);
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: var(--primary-color);
            display: block;
            font-size: 20px;
            font-weight: normal;
            margin-bottom: 10px;
        }

        .hero-sub {
            font-size: 18px;
            color: var(--light-text);
            max-width: 800px;
            margin: 0 auto 30px;
        }

        .hero-badges {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .badge {
            background-color: var(--primary-color);
            color: #fff;
            padding: 5px 15px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 3px;
        }

        /* 2. お悩み共感セクション */
        .check-section {
            padding: 60px 0;
            background-color: #fff;
        }

        .check-box {
            background-color: var(--secondary-color);
            padding: 30px;
            border-radius: 10px;
            max-width: 700px;
            margin: 0 auto;
        }

        .check-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .check-list li {
            position: relative;
            padding-left: 35px;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .check-list li::before {
            content: "□";
            position: absolute;
            left: 5px;
            color: var(--primary-color);
            font-weight: bold;
            font-size: 20px;
        }

        .check-summary {
            text-align: center;
            margin-top: 30px;
            font-size: 16px;
            color: var(--light-text);
        }

        /* 3. 原因解説セクション */
        .cause-section {
            padding: 60px 0;
            background-color: var(--secondary-color);
        }

        .cause-container {
            display: flex;
            align-items: center;
            gap: 40px;
            margin-top: 30px;
        }

        .cause-text {
            flex: 1;
        }

        .cause-img {
            flex: 1;
            background-color: #ddd;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            color: #666;
            font-weight: bold;
        }

        .steps {
            margin-top: 20px;
        }

        .step-item {
            margin-bottom: 15px;
        }

        .step-title {
            font-weight: bold;
            color: var(--primary-color);
        }

        /* 4. 施術特徴セクション */
        .features-section {
            padding: 60px 0;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .feature-card {
            border: 2px solid var(--secondary-color);
            padding: 25px;
            border-radius: 8px;
            text-align: center;
        }

        .feature-card h3 {
            color: var(--primary-color);
            font-size: 20px;
            margin-top: 0;
        }

        /* 5. 施術の流れセクション */
        .flow-section {
            padding: 60px 0;
            background-color: var(--secondary-color);
        }

        .flow-timeline {
            max-width: 800px;
            margin: 0 auto;
        }

        .flow-step {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .flow-step-num {
            color: var(--primary-color);
            font-weight: bold;
            font-size: 14px;
            text-transform: uppercase;
        }

        .flow-step h3 {
            margin: 5px 0 10px 0;
            font-size: 18px;
        }

        /* 6. 社会的証明（お客様の声） */
        .voice-section {
            padding: 60px 0;
        }

        .voice-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .voice-card {
            background-color: #fff;
            border-left: 5px solid var(--primary-color);
            padding: 25px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            border-radius: 0 8px 8px 0;
        }

        .voice-meta {
            font-weight: bold;
            margin-bottom: 10px;
            font-size: 14px;
            color: var(--light-text);
        }

        /* 7. 料金案内・オファー */
        .price-section {
            padding: 60px 0;
            background: linear-gradient(135deg, #005caf 0%, #003366 100%);
            color: #fff;
            text-align: center;
        }

        .price-section h2 {
            color: #fff;
        }

        .price-section h2::after {
            background-color: #fff;
        }

        .price-box {
            background-color: #fff;
            color: var(--text-color);
            max-width: 600px;
            margin: 30px auto;
            padding: 40px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .price-old {
            text-decoration: line-through;
            color: var(--light-text);
            font-size: 18px;
        }

        .price-new {
            color: #e74c3c;
            font-size: 48px;
            font-weight: bold;
            margin: 10px 0;
        }

        .price-reason {
            font-size: 14px;
            color: var(--light-text);
            text-align: left;
            max-width: 500px;
            margin: 20px auto 0;
            line-height: 1.6;
        }

        /* 8. 店舗情報・予約への導線 */
        .info-section {
            padding: 60px 0;
            text-align: center;
        }

        .info-table {
            max-width: 600px;
            margin: 0 auto 30px;
            width: 100%;
            border-collapse: collapse;
        }

        .info-table th, .info-table td {
            padding: 15px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        .info-table th {
            width: 30%;
            background-color: var(--secondary-color);
            color: var(--primary-color);
        }

        .tel-num {
            font-size: 28px;
            font-weight: bold;
            color: var(--primary-color);
            text-decoration: none;
            display: block;
            margin-top: 10px;
        }

        /* 9. 免責事項 */
        footer {
            background-color: #333;
            color: #ccc;
            padding: 40px 0;
            font-size: 12px;
        }

        /* レスポンシブ対応 */
        @media (max-width: 768px) {
            h2 { font-size: 24px; }
            .hero h1 { font-size: 24px; }
            .hero-sub { font-size: 16px; }
            .cause-container { flex-direction: column; }
            .features-grid { grid-template-columns: 1fr; }
            .voice-container { grid-template-columns: 1fr; }
            .price-new { font-size: 36px; }
        }
    </style>
</head>
<body>

    <!-- 1. ファーストビュー -->
